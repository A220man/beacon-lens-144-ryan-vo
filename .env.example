# Beacon Lens Environment Template
# Copy to .env and fill in values

# Backend
DATABASE_URL=postgresql+asyncpg://beacon:beacon@localhost:5432/beacon_lens
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=beacon-lens
KEYCLOAK_CLIENT_ID=beacon-lens-backend
KEYCLOAK_CLIENT_SECRET=
PORT=8000

# LLM Configuration (optional - for AI features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Development
DEBUG=true
LOG_LEVEL=INFO